rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Experiences Repository
    match /experiences/{experienceId} {
      // Anyone can read public / community experiences
      allow read: if resource.data.isPublic == true || resource.data.isDemo == true || (request.auth != null && request.auth.uid == resource.data.userId);
      // Authenticated users can create experiences
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Authors can update or delete their own experiences; or allow voting updates
      allow update: if (request.auth != null && request.auth.uid == resource.data.userId) || 
                      (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usefulCount', 'notUsefulCount']));
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Problems
    match /problems/{problemId} {
      allow read, write: if request.auth != null && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }
    
    // Solutions
    match /solutions/{solutionId} {
      allow read, write: if request.auth != null && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }
    
    // Outcome Feedback
    match /outcomeFeedback/{feedbackId} {
      allow read, write: if request.auth != null && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }
    
    // Saved Solutions
    match /savedSolutions/{savedId} {
      allow read, write: if request.auth != null && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }
  }
}
